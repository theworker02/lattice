{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "lattice-mirrorfield",
  "main": "workers/site-worker.mjs",
  "compatibility_date": "2026-09-13",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
